---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import NewLifeSet from '../components/NewLifeSet.astro';
import Products from '../components/Products.astro';
import DeliverySupport from '../components/DeliverySupport.astro';
import Purchase from '../components/Purchase.astro';
import FlowAndWarranty from '../components/FlowAndWarranty.astro';
import Faq from '../components/Faq.astro';
import Access from '../components/Access.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <NewLifeSet />
    <Products />
    <DeliverySupport />
    <Purchase />
    <FlowAndWarranty />
    <Faq />
    <Access />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
