---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<span class:list={['brand', { 'brand--compact': compact }]}>
  <svg class="brand__mark" width="46" height="40" viewBox="0 0 46 40" fill="none" aria-hidden="true"><path d="M2 35 18 5l10 18 6-10 11 22H2Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="m12 16 6 5 6-5M8 35l10-14 8 14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  <span class="brand__type"><span class="brand__english">EVEREST<span class="brand__dot">.</span></span><span class="brand__japanese">エベレスト株式会社</span></span>
</span>
